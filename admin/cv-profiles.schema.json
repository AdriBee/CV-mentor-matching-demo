{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CV profile collection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profiles"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "profiles": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/definitions/profile"
      }
    }
  },
  "definitions": {
    "shortText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "longText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000
    },
    "nullableText": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 300
    },
    "shortList": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 40,
      "items": {
        "$ref": "#/definitions/shortText"
      }
    },
    "year": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1900,
      "maximum": 2100
    },
    "url": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri",
      "pattern": "^https://",
      "maxLength": 2000
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "identity",
        "research",
        "selectedPublications",
        "grants",
        "mentorship",
        "workflow",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 80
        },
        "status": {
          "enum": [
            "draft",
            "administrator_review",
            "mentor_review",
            "approved",
            "published",
            "rejected",
            "needs_reprocessing",
            "archived"
          ]
        },
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "degrees",
            "title",
            "appointment",
            "institution",
            "email",
            "website"
          ],
          "properties": {
            "name": {
              "$ref": "#/definitions/shortText"
            },
            "degrees": {
              "$ref": "#/definitions/shortList"
            },
            "title": {
              "$ref": "#/definitions/shortText"
            },
            "appointment": {
              "$ref": "#/definitions/shortText"
            },
            "institution": {
              "$ref": "#/definitions/shortText"
            },
            "email": {
              "type": [
                "string",
                "null"
              ],
              "format": "email",
              "maxLength": 254
            },
            "website": {
              "$ref": "#/definitions/url"
            }
          }
        },
        "research": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "summary",
            "areas",
            "topics",
            "specialties",
            "methods"
          ],
          "properties": {
            "summary": {
              "$ref": "#/definitions/longText"
            },
            "areas": {
              "type": "array",
              "uniqueItems": true,
              "maxItems": 4,
              "items": {
                "enum": [
                  "B2B",
                  "CGH",
                  "E2PS",
                  "EpiBio"
                ]
              }
            },
            "topics": {
              "$ref": "#/definitions/shortList"
            },
            "specialties": {
              "$ref": "#/definitions/shortList"
            },
            "methods": {
              "$ref": "#/definitions/shortList"
            }
          }
        },
        "selectedPublications": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title",
              "authors",
              "journal",
              "year",
              "doi",
              "url"
            ],
            "properties": {
              "title": {
                "$ref": "#/definitions/shortText"
              },
              "authors": {
                "$ref": "#/definitions/shortList"
              },
              "journal": {
                "$ref": "#/definitions/nullableText"
              },
              "year": {
                "$ref": "#/definitions/year"
              },
              "doi": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^10\\.[0-9]{4,9}/\\S+$",
                "maxLength": 300
              },
              "url": {
                "$ref": "#/definitions/url"
              }
            }
          }
        },
        "grants": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title",
              "funder",
              "role",
              "startYear",
              "endYear"
            ],
            "properties": {
              "title": {
                "$ref": "#/definitions/shortText"
              },
              "funder": {
                "$ref": "#/definitions/nullableText"
              },
              "role": {
                "$ref": "#/definitions/nullableText"
              },
              "startYear": {
                "$ref": "#/definitions/year"
              },
              "endYear": {
                "$ref": "#/definitions/year"
              }
            }
          }
        },
        "mentorship": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "availability",
            "capacity",
            "desiredSkills",
            "projects",
            "protectedTime",
            "lastConfirmedAt"
          ],
          "properties": {
            "availability": {
              "enum": [
                null,
                "Accepting",
                "By Request",
                "Closed"
              ]
            },
            "capacity": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 100
            },
            "desiredSkills": {
              "$ref": "#/definitions/shortList"
            },
            "projects": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "title",
                  "summary",
                  "commitment"
                ],
                "properties": {
                  "title": {
                    "$ref": "#/definitions/shortText"
                  },
                  "summary": {
                    "$ref": "#/definitions/longText"
                  },
                  "commitment": {
                    "$ref": "#/definitions/nullableText"
                  }
                }
              }
            },
            "protectedTime": {
              "enum": [
                null,
                "Available",
                "By arrangement",
                "Not available"
              ]
            },
            "lastConfirmedAt": {
              "type": [
                "string",
                "null"
              ],
              "format": "date"
            }
          }
        },
        "workflow": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "consentConfirmed",
            "reviewedBy",
            "reviewedAt"
          ],
          "properties": {
            "consentConfirmed": {
              "type": "boolean"
            },
            "reviewedBy": {
              "$ref": "#/definitions/nullableText"
            },
            "reviewedAt": {
              "type": [
                "string",
                "null"
              ],
              "format": "date"
            },
            "sourceFile": {
              "type": "string",
              "minLength": 1,
              "maxLength": 180,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.pdf$"
            },
            "sourceSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "processedAt": {
              "type": "string",
              "format": "date-time"
            },
            "extractorVersion": {
              "$ref": "#/definitions/shortText"
            },
            "classifierVersion": {
              "$ref": "#/definitions/shortText"
            },
            "sourceType": {
              "enum": [
                "cv",
                "manual",
                "synthetic"
              ]
            },
            "synthetic": {
              "type": "boolean"
            },
            "approvalMethod": {
              "enum": [
                "automatic",
                "manual"
              ]
            },
            "approvalPolicy": {
              "enum": [
                "cv-auto-v1",
                "cv-admin-v1"
              ]
            },
            "publicationAuthorized": {
              "type": "boolean"
            },
            "authorizedBy": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}$"
            },
            "approvedAt": {
              "type": "string",
              "format": "date"
            }
          }
        },
        "evidence": {
          "type": "object",
          "maxProperties": 500,
          "propertyNames": {
            "pattern": "^(identity|research|selectedPublications|grants|cv)(\\.[A-Za-z][A-Za-z0-9]*|\\.[0-9]+)+$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sourcePage",
              "sourceText",
              "confidence"
            ],
            "properties": {
              "sourcePage": {
                "type": "integer",
                "minimum": 1,
                "maximum": 500
              },
              "sourceText": {
                "type": "string",
                "minLength": 1,
                "maxLength": 3000
              },
              "confidence": {
                "enum": [
                  "high",
                  "medium",
                  "low"
                ]
              }
            }
          }
        },
